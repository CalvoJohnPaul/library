{
	"name": "@library/root",
	"private": true,
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.6.0"
		},
		"runtime": [
			{
				"name": "node",
				"version": "26.x"
			}
		]
	},
	"scripts": {
		"web": "pnpm --filter @library/web",
		"api": "pnpm --filter @library/api",
		"types": "pnpm --filter @library/types",
		"dev": "turbo run dev",
		"start": "turbo run start",
		"build": "turbo run build",
		"test": "turbo run test",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"seed": "pnpm --filter @library/api exec prisma db seed",
		"create-account": "pnpm --filter @library/api exec create-account"
	},
	"dependencies": {
		"@biomejs/biome": "^2.5.15",
		"turbo": "^2.11.10"
	}
}
