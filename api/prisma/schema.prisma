generator client {
  provider = "prisma-client"
  output   = "./.generated"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String
  dateTimeCreated DateTime @default(now())
  dateTimeUpdated DateTime @updatedAt
}

enum BookStatus {
  AVAILABLE
  BORROWED
}

enum BookGenre {
  FICTION
  NON_FICTION
  ROMANCE
  FANTASY
  SCIENCE_FICTION
  MYSTERY
  THRILLER
  HORROR
  HISTORICAL_FICTION
  BIOGRAPHY
  SELF_HELP
  HISTORY
  PHILOSOPHY
  PSYCHOLOGY
  BUSINESS
  SCIENCE
  TRAVEL
  RELIGION_SPIRITUALITY
  YOUNG_ADULT
  CHILDREN
  POETRY
}

model Book {
  id              Int        @id @default(autoincrement())
  title           String
  author          String
  genre           BookGenre
  yearPublished   Int
  dateTimeCreated DateTime   @default(now())
  dateTimeUpdated DateTime   @updatedAt
  copies          BookCopy[]
}

model BookCopy {
  id              Int           @id @default(autoincrement())
  isbn            String        @unique
  book            Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId          Int
  status          BookStatus    @default(AVAILABLE)
  dateTimeCreated DateTime      @default(now())
  dateTimeUpdated DateTime      @updatedAt
  transactions    Transaction[]
}

model Member {
  id                       Int           @id @default(autoincrement())
  externalId               String        @unique
  name                     String
  course                   String?
  yearAndSection           String?
  dateTimeLastBorrowedBook DateTime?
  dateTimeCreated          DateTime      @default(now())
  dateTimeUpdated          DateTime      @updatedAt
  transactions             Transaction[]
}

enum TransactionType {
  BORROW
  RETURN
}

enum TransactionStatus {
  PENDING
  COMPLETED
}

model Transaction {
  id              Int               @id @default(autoincrement())
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  ticket          String
  remarks         String?
  member          Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId        Int
  bookCopy        BookCopy          @relation(fields: [bookCopyId], references: [id], onDelete: Cascade)
  bookCopyId      Int
  dateTimeCreated DateTime          @default(now())
  dateTimeUpdated DateTime          @updatedAt

  @@unique([ticket, type])
}
