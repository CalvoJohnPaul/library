generator client {
  provider = "prisma-client"
  output   = "../src/.generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String
  dateTimeCreated DateTime @default(now())
  dateTimeUpdated DateTime @updatedAt
}
