generator client {
  provider = "prisma-client"
  output   = "./.generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String
  dateTimeCreated DateTime @default(now())
  dateTimeUpdated DateTime @updatedAt
}

enum BookStatus {
  AVAILABLE
  BORROWED
  RESERVED
}

enum BookGenre {
  FICTION
  NON_FICTION
  ROMANCE
  FANTASY
  SCIENCE_FICTION
  MYSTERY
  THRILLER
  HORROR
  HISTORICAL_FICTION
  BIOGRAPHY
  SELF_HELP
  HISTORY
  PHILOSOPHY
  PSYCHOLOGY
  BUSINESS
  SCIENCE
  TRAVEL
  RELIGION_SPIRITUALITY
  YOUNG_ADULT
  CHILDREN
  POETRY
}

model Book {
  id              Int           @id @default(autoincrement())
  title           String
  author          String
  genre           BookGenre
  yearPublished   Int
  dateTimeCreated DateTime      @default(now())
  dateTimeUpdated DateTime      @updatedAt
  copies          BookCopy[]
  reservations    Reservation[]
  transactions    Transaction[]

  @@index([dateTimeCreated])
  @@index([dateTimeUpdated])
  @@index([genre])
}

model BookCopy {
  id              Int           @id @default(autoincrement())
  isbn            String        @unique
  book            Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId          Int
  status          BookStatus    @default(AVAILABLE)
  dateTimeCreated DateTime      @default(now())
  dateTimeUpdated DateTime      @updatedAt
  transactions    Transaction[]
  reservations    Reservation[]

  @@index([status])
  @@index([dateTimeCreated])
  @@index([dateTimeUpdated])
  @@index([bookId])
  @@index([bookId, status])
}

model Member {
  id                       Int           @id @default(autoincrement())
  externalId               String        @unique
  name                     String
  course                   String?
  yearAndSection           String?
  dateTimeLastBorrowedBook DateTime?
  dateTimeCreated          DateTime      @default(now())
  dateTimeUpdated          DateTime      @updatedAt
  transactions             Transaction[]
  reservations             Reservation[]

  @@index([dateTimeCreated])
  @@index([dateTimeUpdated])
  @@index([dateTimeLastBorrowedBook])
}

enum TransactionType {
  BORROW
  RETURN
  RESERVE
  UNRESERVE
}

enum TransactionStatus {
  PENDING
  COMPLETED
}

model Transaction {
  id              Int               @id @default(autoincrement())
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  ticket          String
  remarks         String?
  member          Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId        Int
  book            Book?             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId          Int?
  bookCopy        BookCopy?         @relation(fields: [bookCopyId], references: [id], onDelete: Cascade)
  bookCopyId      Int?
  reservation     Reservation?      @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  reservationId   Int?
  dateTimeCreated DateTime          @default(now())
  dateTimeUpdated DateTime          @updatedAt

  @@unique([ticket, type])
  @@index([type, dateTimeCreated])
  @@index([status, dateTimeCreated])
  @@index([dateTimeUpdated])
  @@index([memberId, type, dateTimeCreated])
  @@index([bookCopyId, type, dateTimeCreated])
  @@index([bookId, type, dateTimeCreated])
  @@index([reservationId])
}

enum ReservationStatus {
  PENDING
  CANCELLED
  COMPLETED
}

model Reservation {
  id              Int               @id @default(autoincrement())
  book            Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId          Int
  bookCopy        BookCopy?         @relation(fields: [bookCopyId], references: [id], onDelete: SetNull)
  bookCopyId      Int?
  member          Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId        Int
  status          ReservationStatus @default(PENDING)
  ticket          String            @unique
  remarks         String?
  transactions    Transaction[]
  dateTimeCreated DateTime          @default(now())
  dateTimeUpdated DateTime          @updatedAt

  @@unique([bookId, memberId], where: {status: "PENDING"})
  @@index([status, bookCopyId])
}
