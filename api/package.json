		"@fastify/rate-limit": "11.2.1",
		"@fastify/schedule": "7.0.2",
		"@fastify/secure-session": "8.4.1",
		"@fastify/sensible": "6.0.7",
		"@fastify/swagger": "9.9.2",
		"@fastify/swagger-ui": "6.1.2",
		"@library/types": "workspace:*",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"bcrypt": "6.0.0",
		"date-fns": "4.4.0",
		"dotenv": "18.0.8",
		"es-toolkit": "1.52.0",
