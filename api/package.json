{
	"name": "@library/api",
	"type": "commonjs",
	"private": true,
	"scripts": {
		"dev": "tsx watch --include=\\\"./src/**/*\\\" --include=\\\"../types/dist/**/*\\\" --no-warnings --env-file=.env --clear-screen=false ./src/main.ts",
		"start": "node -r dotenv/config dist/main.cjs",
		"build": "tsdown",
		"test": "vitest run",
		"postinstall": "prisma generate",
		"create-account": "tsx --env-file=.env -- ./scripts/createAccount.ts"
	},
	"dependencies": {
